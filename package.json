{
  "name": "flokefama-website",
  "version": "0.1.0",
  "private": true,
  "description": "Flokefama website redesign: prototype, design system and social flyer templates",
  "type": "module",
  "scripts": {
    "dev": "npx --yes serve site -l 5173",
    "build": "npm run icons && npm run build:3d",
    "icons": "python3 scripts/subset-icons.py",
    "build:3d": "esbuild src/hero3d.js --bundle --minify --format=iife --target=es2020 --legal-comments=none --outfile=site/assets/js/hero3d.js",
    "images": "node scripts/optimize-images.mjs",
    "flyers": "node scripts/export-flyers.mjs",
    "qa": "node scripts/qa-screens.mjs"
  },
  "devDependencies": {
    "@flaticon/flaticon-uicons": "^3.3.1",
    "esbuild": "^0.25.12",
    "playwright": "1.56.1",
    "three": "^0.186.1"
  }
}
