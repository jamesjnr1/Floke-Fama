{
  "name": "flokefama-web",
  "version": "1.0.0",
  "private": true,
  "description": "Flokefama: composable Next.js 15 site with Sanity CMS, Algolia search and a B2B procurement portal",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "icons": "python3 scripts/subset-icons.py",
    "algolia:sync": "node --experimental-strip-types scripts/algolia-sync.ts",
    "qa": "node scripts/qa.mjs",
    "flyers": "node scripts/export-flyers.mjs",
    "images": "node scripts/optimize-images.mjs"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@sanity/client": "^8.9.0",
    "@sanity/image-url": "^2.1.1",
    "algoliasearch": "^5.59.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.7.2",
    "motion": "^13.4.6",
    "next": "^15.5.27",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@flaticon/flaticon-uicons": "^3.3.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "playwright": "1.56.1",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3"
  }
}
