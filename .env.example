# Copy to .env.local and fill in. Every integration is optional:
# without these values the site runs on the bundled seed data (src/data/seed.ts).

# --- Sanity (headless CMS) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=

# --- Algolia (instant product search) ---
NEXT_PUBLIC_ALGOLIA_APP_ID=
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=
NEXT_PUBLIC_ALGOLIA_INDEX=products
ALGOLIA_ADMIN_KEY=            # server-only, used by `npm run algolia:sync`

# --- HubSpot (quote requests → CRM) ---
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_GUID=

# --- Site ---
# Origin of this deployment. Leave unset on Vercel (the Vercel URL is used automatically).
# Do NOT set it to the live flokefama.com before an approved launch.
NEXT_PUBLIC_SITE_URL=
# Launch switch: search engines are blocked unless this is exactly "true".
# Only set it after Flokefama approves going live.
NEXT_PUBLIC_ALLOW_INDEXING=
