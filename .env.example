# Copy to .env.local and fill in. Every integration is optional:
# without these values the site runs on the bundled seed data (src/data/seed.ts).

# --- Sanity (headless CMS) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=
# Signs the Sanity webhook that refreshes the site the moment an editor publishes (see studio/README.md)
SANITY_REVALIDATE_SECRET=

# --- Algolia (instant product search) ---
NEXT_PUBLIC_ALGOLIA_APP_ID=
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=
NEXT_PUBLIC_ALGOLIA_INDEX=products
ALGOLIA_ADMIN_KEY=            # server-only, used by `npm run algolia:sync`

# --- Brevo (support requests → the support inbox; new orders and demonstration requests → sales) ---
# Free for up to 300 emails a day. Create an API key (Brevo → SMTP & API → API keys) and confirm the sender
# address (Brevo → Senders: one click in the email Brevo sends; no website or DNS changes).
# Without it, the visitor sends the request by email or WhatsApp, pre-filled.
BREVO_API_KEY=                  # Sensitive in Vercel
BREVO_SENDER_EMAIL=             # e.g. support@flokefama.com (confirmed in Brevo)
SUPPORT_EMAIL_TO=               # who receives requests, comma-separated; empty = the sender address
SALES_EMAIL_TO=                 # who is emailed each new shop order (and demonstration request), comma-separated; empty = SUPPORT_EMAIL_TO

# --- Site ---
# Origin of this deployment. Leave unset on Vercel (the Vercel URL is used automatically).
# Do NOT set it to the live flokefama.com before an approved launch.
NEXT_PUBLIC_SITE_URL=
# Launch switch: search engines are blocked unless this is exactly "true".
# Only set it after Flokefama approves going live.
NEXT_PUBLIC_ALLOW_INDEXING=

# --- Portal sign-in ---
# Signs the session cookie. REQUIRED before real users get access: a long random value,
# e.g. `openssl rand -base64 48`. Without it a preview-only fallback is used.
SESSION_SECRET=
# Engineers: emails (comma-separated) that sign in to /engineer instead of the hospital dashboard.
# They register through "Register hospital" like everyone else. Register the account first, then add
# the email here, so nobody else can claim the address.
ENGINEER_EMAILS=
# The sales team: sign in at /admin/login like admins, but see only Orders (the sales board) and Product demand.
# They register at /login first, then their email goes here (comma-separated).
SALES_EMAILS=
# Admins: emails (comma-separated) that sign in to the admin console at /admin (orders, accounts,
# service tickets, database health). Same as engineers: register the account first, then add the email.
ADMIN_EMAILS=

# Menu bar style: empty or "bar" = dark bar across the full width (default); "floating" = the earlier
# rounded bar that floats over the page. Change it in Vercel, then redeploy.
NEXT_PUBLIC_NAV_STYLE=

# "Meet our CEO" on About: empty = the green band, with Profile / Education / Honours / Philanthropy buttons; "tabs" = the earlier section with tabs.
NEXT_PUBLIC_CEO_STYLE=

# Mission / Vision / Aim on About and Home: empty = cards (coloured top, text on white); "blocks" = the earlier solid blocks.
NEXT_PUBLIC_PURPOSE_STYLE=

# Home hero: empty = everything centred on a green gradient with the eight equipment types in a row of large photos
# (a hovered one widens); "moving" = a large row of equipment photos moving across, with the headline and actions
# underneath; "feature" = the text beside one large equipment photo with thumbnails; "spotlight" = one photo filling
# the right side with a numbered index; "collage" = a collage of the eight equipment types; "pages" = a stack
# of catalogue pages, the top one turning through the equipment; "catalogue" = an open product catalogue, its page turning through the equipment; "strips" = the headline with the
# equipment as photo strips underneath; "card" = the earlier hero with the equipment in a cross-fading card;
# "carousel" = the earlier hero with a row of product tiles.
NEXT_PUBLIC_HERO_LAYOUT=

# Home hero background: empty = the dark teal; "navy", "graphite", "light", "dots" or "aurora" for the others.
NEXT_PUBLIC_HERO_BG=

# --- Alerts on phones and computers (Web Push) for new service requests and updates ---
# Generate once with: npx web-push generate-vapid-keys. Needs Appwrite too (table push_subscriptions).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=              # Sensitive in Vercel
VAPID_SUBJECT=mailto:support@flokefama.com

# --- Appwrite (database + file storage: hospital accounts, logos, orders and the service desk) ---
# Server-only: never prefix these with NEXT_PUBLIC_. Without them, accounts stay in a signed cookie and
# logos, orders and the service desk in the browser. Create the tables and bucket once with `npm run appwrite:setup`.
APPWRITE_ENDPOINT=            # e.g. https://fra.cloud.appwrite.io/v1 (Settings → API credentials)
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=             # API key with database and storage access (Sensitive in Vercel)
APPWRITE_DATABASE_ID=flokefama   # the free plan allows one database: if the project already has one, use its ID

# Faint background patterns (grid, dots, crosses) on the light sections: empty = on; "off" = plain backgrounds.
NEXT_PUBLIC_PATTERNS=

# --- Text messages (SMS) to engineers: urgent faults, jobs given to them, hospitals' messages, escalations ---
# Empty = off. "log" = nothing is sent; each text is only recorded and listed in the admin console (Service tab),
# for trying it out. Otherwise a Ghanaian gateway: "arkesel" or "mnotify" (SMS_API_KEY), or "hubtel"
# (SMS_CLIENT_ID and SMS_CLIENT_SECRET). Needs Appwrite (run `npm run appwrite:setup` once for the sms_log table).
# Engineers and admins are texted on the phone number on their account.
SMS_PROVIDER=
SMS_API_KEY=                    # Sensitive in Vercel
SMS_CLIENT_ID=
SMS_CLIENT_SECRET=              # Sensitive in Vercel
# The name texts come from (up to 11 letters). Register it with the gateway first; it can take a few days.
SMS_SENDER_ID=Flokefama               # exactly as approved in Arkesel (case matters)
# Which new requests text every engineer (the others still reach the portal and phone alerts).
SMS_URGENT_PRIORITIES=critical,high
# If an urgent request is still untaken after this many minutes, the admins and the numbers below are texted
# (once per request). 0 = no escalation.
SMS_ESCALATE_MINUTES=30
SMS_ESCALATION_NUMBERS=         # e.g. 0244000111,0533392863
# Texts to hospitals (check-in 7 days after a repair, calibration reminder 14 days before, New Year, Independence
# Day, Easter and Christmas greetings) go out from a daily run at 9:00 (vercel.json → /api/cron/clients), which
# needs CRON_SECRET. CLIENT_TEXTS=off stops the automatic ones; Admin → Text messages still sends to all hospitals.
CLIENT_TEXTS=on
# Five greetings go out automatically (Independence Day, Easter, World Health Day, Breast Cancer Awareness Month,
# Christmas). Add others by their key (see Admin → Text messages → the greetings calendar), e.g. nurses,heart,
# or leave one out, e.g. easter
CLIENT_TEXTS_ADD=
CLIENT_TEXTS_SKIP=
# Lets a scheduler run the escalation check when no portal is open: call /api/cron/sms every 5-10 minutes with
# the header "Authorization: Bearer <CRON_SECRET>" (Vercel Cron on the Pro plan, or free at cron-job.org).
# At least 16 characters, e.g. `openssl rand -hex 24`.
CRON_SECRET=                    # Sensitive in Vercel
