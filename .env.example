# Copy to .env.local and fill in. Every integration is optional:
# without these values the site runs on the bundled seed data (src/data/seed.ts).

# --- Sanity (headless CMS) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=
# Signs the Sanity webhook that refreshes the site the moment an editor publishes (see studio/README.md)
SANITY_REVALIDATE_SECRET=

# --- Algolia (instant product search) ---
NEXT_PUBLIC_ALGOLIA_APP_ID=
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=
NEXT_PUBLIC_ALGOLIA_INDEX=products
ALGOLIA_ADMIN_KEY=            # server-only, used by `npm run algolia:sync`

# --- HubSpot (quote requests + contact messages → CRM) ---
# Without these, forms hand the message to the visitor's email / WhatsApp, pre-filled, so nothing is lost.
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_GUID=

# --- Site ---
# Origin of this deployment. Leave unset on Vercel (the Vercel URL is used automatically).
# Do NOT set it to the live flokefama.com before an approved launch.
NEXT_PUBLIC_SITE_URL=
# Launch switch: search engines are blocked unless this is exactly "true".
# Only set it after Flokefama approves going live.
NEXT_PUBLIC_ALLOW_INDEXING=

# --- Portal sign-in ---
# Signs the session cookie. REQUIRED before real users get access: a long random value,
# e.g. `openssl rand -base64 48`. Without it a preview-only fallback is used.
SESSION_SECRET=
# Engineers: emails (comma-separated) that sign in to /engineer instead of the hospital dashboard.
# They register through "Register hospital" like everyone else.
ENGINEER_EMAILS=

# --- Appwrite (database + file storage: hospital accounts, logos, orders and the service desk) ---
# Server-only: never prefix these with NEXT_PUBLIC_. Without them, accounts stay in a signed cookie and
# logos, orders and the service desk in the browser. Create the tables and bucket once with `npm run appwrite:setup`.
APPWRITE_ENDPOINT=            # e.g. https://fra.cloud.appwrite.io/v1 (Settings → API credentials)
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=             # API key with database and storage access (Sensitive in Vercel)
APPWRITE_DATABASE_ID=flokefama   # the free plan allows one database: if the project already has one, use its ID
